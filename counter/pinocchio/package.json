{
  "name": "pinocchio-counter-client",
  "version": "0.1.0",
  "description": "Client tests for pinocchio-counter program",
  "main": "index.js",
  "scripts": {
    "test": "cargo +stable test --manifest-path tests-magicsvm-rs/Cargo.toml",
    "build": "cargo build-sbf --features logging",
    "build:release": "cargo build --release",
    "build:dev": "cargo build",
    "check": "cargo check",
    "lint": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern */*.js \"*/**/*{.js,.ts}\" --check",
    "lint:fix": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern */*.js \"*/**/*{.js,.ts}\" -w"
  },
  "keywords": [
    "solana",
    "pinocchio",
    "counter",
    "program"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
