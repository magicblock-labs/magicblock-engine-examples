{
  "name": "gasless-starter-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "prettier --config ../../../.prettierrc.json --ignore-path ../../../.prettierignore --no-error-on-unmatched-pattern \"src/**/*.{css,ts,tsx}\" \"test/**/*.ts\" \"*.{html,js,ts,json}\" --check",
    "lint:fix": "prettier --config ../../../.prettierrc.json --ignore-path ../../../.prettierignore --no-error-on-unmatched-pattern \"src/**/*.{css,ts,tsx}\" \"test/**/*.ts\" \"*.{html,js,ts,json}\" --write"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.5.3",
    "tsx": "^4.22.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
