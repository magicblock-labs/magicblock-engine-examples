{
  "name": "@magicblock-labs/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared helpers for example tests",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "lint": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern \"src/**/*.ts\" --check",
    "lint:fix": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern \"src/**/*.ts\" -w"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.14.3",
    "@magicblock-labs/magicsvm": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
